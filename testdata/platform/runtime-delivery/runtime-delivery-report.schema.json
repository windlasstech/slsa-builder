{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slsa-builder.dev/schemas/test/runtime-delivery-report-v1.json",
  "title": "Non-production runtime delivery spike report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "requested_sha",
    "executed_sha",
    "job_workflow_sha",
    "job_workflow_ref",
    "platform_workflow_sha",
    "platform_workflow_ref",
    "payload_executed",
    "failure_phase"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result": {
      "enum": ["pass", "fail"]
    },
    "requested_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "executed_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "job_workflow_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "job_workflow_ref": {
      "type": ["string", "null"]
    },
    "platform_workflow_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platform_workflow_ref": {
      "type": "string"
    },
    "payload_executed": {
      "type": "boolean"
    },
    "failure_phase": {
      "type": ["string", "null"]
    },
    "failure_reason": {
      "type": "string"
    }
  }
}
